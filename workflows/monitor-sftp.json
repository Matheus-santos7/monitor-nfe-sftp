        "jsCode": "console.log(`▶ Montar relatório do furo  ${$json.referencia || ''}  ${$json.proximaAcao || ''}`);\nfunction jsonDe(nomeNo) {\n  try {\n    return $(nomeNo).item.json;\n  } catch (e) {\n    return null;\n  }\n}\n\nconst entrada = $input.first().json;\nconst executionId = entrada.executionId || $execution.id;\nconst diag = jsonDe('Diagnosticar no Nerus');\nconst sftp = jsonDe('Rechecar FTP');\nconst origem = jsonDe('Normalizar invoice') || entrada;\n\nif (!diag && entrada.mensagem) {\n  return [{\n    json: {\n      ...entrada,\n      executionId,\n      mensagem: `${entrada.mensagem}\\n\\nexecução n8n=${executionId}`,\n    },\n  }];\n}\n\nconst extra = [];\nif (sftp && Array.isArray(sftp.notasAusentes)) {\n  const aindaFuro = sftp.notasAusentes.some(\n    (n) => Number(n.numero) === Number(origem.numero) && Number(n.serie) === Number(origem.serie),\n  );\n  extra.push(\n    aindaFuro\n      ? 'SFTP: a NF continua ausente no FTP após o diagnóstico.'\n      : 'SFTP: XML encontrado no FTP após o diagnóstico.',\n  );\n} else if (sftp && (sftp.error || sftp.ok === false)) {\n  extra.push(`Rechecar FTP falhou: ${sftp.erro || sftp.error?.message || 'HTTP'}`);\n}\n\nconst mensagemBase =\n  (diag && diag.mensagem) || (\n    origem.encontrado\n      ? `Invoice ${origem.invoiceId} mapeada, mas o diagnóstico não rodou.`\n      : `NF ${origem.referencia} não encontrada no relatório do Mercado Livre.`\n  );\n\nconst mensagem = [mensagemBase, ...extra, `execução n8n=${executionId}`]\n  .filter((l) => String(l ?? '').trim())\n  .join('\\n');\n\nreturn [{\n  json: {\n    referencia: origem.referencia,\n    numero: origem.numero,\n    serie: origem.serie,\n    invoiceId: origem.invoiceId || (diag && diag.invoiceId) || null,\n    encontrado: Boolean(origem.encontrado),\n    motivo: origem.motivo,\n    identificador: origem.identificador,\n    executionId,\n    proximaAcao: (diag && diag.proximaAcao) || origem.proximaAcao || 'nenhuma',\n    diagnostico: (diag && diag.diagnostico) || null,\n    precisaAdmin: Boolean(diag && diag.precisaAdmin) || !origem.encontrado,\n    assunto: (diag && diag.assunto) || `NF-e ${origem.referencia} — diagnóstico`,\n    mensagem,\n  },\n}];\n"
      },
