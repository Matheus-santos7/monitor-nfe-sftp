        "jsCode": "console.log(`▶ Normalizar invoice  ${$json.referencia}  encontrado=${$json.encontrado}`);\nconst origem = $('Separar NFs ausentes').item.json;\nconst rel = $input.first().json;\nconst falhou = Boolean(rel.error || rel.erro || rel.ok === false);\nconst invoiceId = falhou ? null : (rel.invoiceId ?? null);\n\nreturn [{\n  json: {\n    referencia: origem.referencia,\n    numero: origem.numero,\n    serie: origem.serie,\n    invoiceId,\n    chave: falhou ? null : (rel.chave ?? null),\n    xmlNome: rel.xmlNome ?? null,\n    periodo: rel.periodo ?? null,\n    tentativas: rel.tentativas ?? null,\n    encontrado: Boolean(!falhou && rel.encontrado && invoiceId),\n    motivo: falhou\n      ? (rel.erro || rel.error?.message || 'falha_http_buscar_invoice')\n      : (rel.encontrado && invoiceId\n        ? 'xml_ausente_ftp'\n        : (rel.erro || 'invoice_nao_encontrada_no_relatorio_ml')),\n    identificador: origem.identificador,\n    executionId: origem.executionId,\n    mlUserId: origem.mlUserId,\n  },\n}];\n"
