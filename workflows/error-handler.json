        "jsCode": "const d = $input.first().json;\nconst wf = d.workflow || {};\nconst ex = d.execution || {};\nconst err = ex.error || {};\nconst lastNode = ex.lastNodeExecuted || d.lastNodeExecuted || 'desconhecido';\nconst executionId = ex.id || '';\nconst mensagem =\n  '🚨 Workflow n8n falhou.\\n\\n' +\n  `workflow=${wf.name || ''}\\n` +\n  `nó=${lastNode}\\n` +\n  `execução=${executionId}\\n` +\n  `erro=${err.message || d.message || 'sem mensagem'}`;\nreturn [{\n  json: {\n    assunto: `Falha n8n — ${wf.name || 'workflow'}`,\n    mensagem,\n    lastNode,\n    executionId,\n  },\n}];\n"
      },
      "id": "err-0001-4000-8000-000000000002",
