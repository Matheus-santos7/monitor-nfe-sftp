{
  "id": "monSftpNfe000002",
  "name": "1. Monitor SFTP NF-e (v2)",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {},
      "id": "69239d27-84b0-4a63-a0a6-ada8f75915ba",
      "name": "Executar agora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8-18 * * 1-5"
            }
          ]
        }
      },
      "id": "520818ee-2eb7-4511-824a-dc2e3d9f8be4",
      "name": "Agendar checagem",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://monitor-sftp:8080/ciclo",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ execucao: $execution.id }) }}",
        "options": {
          "timeout": 600000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MONITOR_HTTP_TOKEN }}"
            }
          ]
        },
        "authentication": "none"
      },
      "id": "eed2ecd9-5fa4-4e23-8a34-19f6c5f3cfa7",
      "name": "Ciclo de monitoramento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cbef68df-5a8e-4f3c-956d-d30fd6bf9907",
              "leftValue": "={{ $json.lote.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt",
                "rightType": "number"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7b0551a6-3a02-47e1-915f-3599db187662",
      "name": "Há lote para conferir?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ { '10min': 600, '2min': 120 }[$json.espera] ?? 1 }}",
        "unit": "seconds"
      },
      "id": "1d545688-7477-4f32-ba8a-b2f61451e4ae",
      "name": "Esperar o lote (10 min / 2 min)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://monitor-sftp:8080/ciclo/conferir",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ execucao: $execution.id, notas: $('Ciclo de monitoramento').first().json.notasAusentes, lote: $('Ciclo de monitoramento').first().json.lote }) }}",
        "options": {
          "timeout": 180000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
