      "parameters": {
        "jsCode": "console.log(`▶ Separar NFs ausentes  ${$json.referencia || $json.motivo || ''}`);\nconst MAX_FUROS = 5;\nconst seller = $input.first().json;\nconst avaliacao = $('Montar resumo da checagem').first().json;\nconst mlUserId = seller.id || $env.ML_USER_ID;\nconst executionId = avaliacao.executionId || $execution.id;\n\nif (!mlUserId) {\n  throw new Error('GET /users/me não retornou id. Token inválido ou expirado.');\n}\n\nconst notas = Array.isArray(avaliacao.notasAusentes) ? avaliacao.notasAusentes : [];\nif (notas.length === 0) {\n  return [{\n    json: {\n      motivo: 'serie_sem_xml_ou_sem_furo_listavel',\n      mlUserId,\n      identificador: avaliacao.identificador,\n      executionId,\n      furosTotais: 0,\n      furosProcessados: 0,\n    },\n  }];\n}\n\nconst selecionadas = notas.slice(0, MAX_FUROS);\nreturn selecionadas.map((n) => ({\n  json: {\n    numero: n.numero,\n    serie: n.serie,\n    referencia: `${n.numero}/${n.serie}`,\n    motivo: 'xml_ausente_ftp',\n    mlUserId,\n    identificador: avaliacao.identificador,\n    executionId,\n    furosTotais: notas.length,\n    furosProcessados: selecionadas.length,\n  },\n}));\n"
