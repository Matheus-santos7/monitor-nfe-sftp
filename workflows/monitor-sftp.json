    {
      "parameters": {
        "jsCode": "console.log(`▶ Montar resumo da checagem  integração=${$json.integracaoOk}  furos=${($json.notasAusentes || []).length}`);\nfunction parseFakeNota(raw) {\n  const v = String(raw ?? '').trim();\n  if (!v || /^(0|false|off|no|desligada|disabled)$/i.test(v)) return null;\n  const m = v.match(/^(\\d+)\\s*[\\/,;x-]\\s*(\\d+)$/i);\n  if (!m) return null;\n  return { numero: Number(m[1]), serie: Number(m[2]) };\n}\n\nfunction horarioSaoPaulo() {\n  return new Intl.DateTimeFormat('pt-BR', {\n    timeZone: 'America/Sao_Paulo',\n    day: '2-digit',\n    month: '2-digit',\n    year: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: false,\n  }).format(new Date());\n}\n\nconst MAX_DIAGNOSTICOS = 5;\nconst sftp = $input.first().json;\nconst executionId = $execution.id;\nconst horario = horarioSaoPaulo();\n\nif (sftp.ok === false || sftp.erro) {\n  throw new Error(`Checar SFTP falhou: ${sftp.erro || 'resposta inválida'}`);\n}\n\nconst series = Array.isArray(sftp.series) ? sftp.series : [];\nlet notasAusentes = Array.isArray(sftp.notasAusentes) ? [...sftp.notasAusentes] : [];\nlet integracaoOk = series.length > 0 && series.every((s) => s.totalAusentes === 0);\n\nconst fake = parseFakeNota($env.FAKE_NOTA);\nif (fake) {\n  if (!notasAusentes.some((n) => n.numero === fake.numero && n.serie === fake.serie)) {\n    notasAusentes = [fake, ...notasAusentes];\n  }\n  integracaoOk = false;\n}\n\nconst identificador = sftp.identificador || '';\nconst periodo = sftp.tetoPeriodo\n  ? (sftp.tetoPeriodo.start === sftp.tetoPeriodo.end\n      ? `Período teto ML: ${sftp.tetoPeriodo.start}`\n      : `Período teto ML: ${sftp.tetoPeriodo.start}–${sftp.tetoPeriodo.end}`)\n  : '';\nconst seriesLinha = series\n  .map((s) => {\n    const teto = s.tetoMl != null ? `, teto ML ${s.tetoMl} ` : '';\n    return `série ${s.serie} (FTP ${s.min} → ${s.max}${teto})`;\n  })\n  .join('\\n');\n\nconst cabecalho = [identificador, periodo, seriesLinha].filter(Boolean).join('\\n');\nconst prefixoTeste = fake ? `[TESTE FAKE_NOTA] ` : '';\n\nconst mensagemOk =\n  `${prefixoTeste}Monitoramento concluído ${horario}\\n\\n` +\n  'A integração de NF-e das séries monitoradas está 100% OK.\\n' +\n  'A última NF emitida pelo Mercado Livre está no FTP.\\n\\n' +\n  cabecalho;\n\nconst listaNotas = notasAusentes\n  .slice(0, 20)\n  .map((n) => `${n.numero}/${n.serie}`)\n  .join(', ');\n\nconst excedente =\n  notasAusentes.length > MAX_DIAGNOSTICOS\n    ? `\\n\\nDiagnóstico automático nas ${MAX_DIAGNOSTICOS} primeiras; ${notasAusentes.length - MAX_DIAGNOSTICOS} ficam para o próximo ciclo.`\n    : '';\n\nconst mensagemErro =\n  `${prefixoTeste}Monitoramento com pendências ${horario}\\n\\n` +\n  cabecalho +\n  (listaNotas ? `\\n\\nNotas ausentes no FTP: ${listaNotas}` : '') +\n  excedente;\n\ntry {\n  $execution.customData.set('executionId', String(executionId));\n  $execution.customData.set('integracaoOk', String(integracaoOk));\n  $execution.customData.set('furos', String(notasAusentes.length));\n} catch (e) {}\n\nreturn [\n  {\n    json: {\n      identificador,\n      series,\n      tetoPeriodo: sftp.tetoPeriodo || null,\n      integracaoOk,\n      notasAusentes,\n      fakeNota: fake,\n      executionId,\n      assunto: prefixoTeste + (integracaoOk\n        ? `Monitoramento concluído ${horario}`\n        : `Monitoramento com pendências ${horario}`),\n      mensagem: integracaoOk ? mensagemOk : mensagemErro,\n    },\n  },\n];\n"
      },
